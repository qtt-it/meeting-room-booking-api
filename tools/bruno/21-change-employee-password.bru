meta {
  name: Change employee password
  type: http
  seq: 21
}

put {
  url: {{baseUrl}}/api/v1/users/me/password
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{inviteToken}}
}

body:json {
  {
    "currentPassword": "{{employeePassword}}",
    "newPassword": "LocalDemo!2026ChangedEmployee"
  }
}

tests {
  test("Expected HTTP status and successful envelope", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
  });
}
