meta {
  name: Edit pending booking
  type: http
  seq: 15
}

put {
  url: {{baseUrl}}/api/v1/bookings/{{bookingId}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "roomId": "{{roomId}}",
    "title": "Updated planning {{runId}}",
    "startsAt": "{{startsAt}}",
    "endsAt": "{{endsAt}}",
    "attendeeIds": [
      "{{employeeId}}"
    ],
    "recurrence": {
      "frequency": "weekly",
      "interval": 1,
      "count": 2
    },
    "version": {{bookingVersion}}
  }
}

script:post-response {
  bru.setVar("bookingVersion", res.getBody().data.version);
}

tests {
  test("Expected HTTP status and successful envelope", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
  });
}
