meta {
  name: Approve booking
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/v1/bookings/{{bookingId}}/approval
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "version": {{bookingVersion}}
  }
}

script:post-response {
  bru.setVar("bookingVersion", res.getBody().data.version);
}

tests {
  test("Expected HTTP status and successful envelope", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
  });
}
