meta {
  name: Room calendar
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/v1/rooms/{{roomId}}/calendar?from={{startsAt}}&to={{endsAt}}&page=1&pageSize=20
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{token}}
}

tests {
  test("Expected HTTP status and successful envelope", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
  });
}
